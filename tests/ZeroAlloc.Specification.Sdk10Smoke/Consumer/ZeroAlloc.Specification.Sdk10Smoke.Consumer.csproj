<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Specification package with the oldest supported
    .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. The package bundles the generator in
    analyzers/dotnet/cs. If the generator references a newer Roslyn than the compiler that loads
    it, it is skipped with CS9057, And and Not do not exist, and the build fails with CS1061.
    The standalone ZeroAlloc.Specification.Generator package ships the same DLL; the
    roslyn-floor job scans both.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      dotnet pack src/ZeroAlloc.Specification -c Release -o artifacts -p:Version=9.9.9-local.sha$(git rev-parse HEAD | head -c7)
      dotnet pack src/ZeroAlloc.Specification.Generator -c Release -o artifacts -p:Version=9.9.9-local.sha$(git rev-parse HEAD | head -c7)
      cd tests/ZeroAlloc.Specification.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocSpecificationVersion=9.9.9-local.sha$(git rev-parse HEAD | head -c7)
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocSpecificationVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocSpecificationVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocSpecificationVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Specification" Version="[$(ZeroAllocSpecificationVersion)]" />
  </ItemGroup>
</Project>
